generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  fullName     String
  username     String   @unique
  email        String   @unique
  phone        String   @unique
  airtimePurchaseLimitNgn Decimal? @db.Decimal(18, 2)
  passwordHash String

  referralCode String   @unique
  referredById String?
  referredBy   User?    @relation("UserReferrals", fields: [referredById], references: [id])
  referrals    User[]   @relation("UserReferrals")

  wallet       Wallet?
  transactions Transaction[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([referredById])
  taskProgress      TaskProgress[]
  tappingProgress   TappingProgress?
  whotSpins         WhotSpin[]
  withdrawals       Withdrawal[]
  payoutProfile     PayoutProfile?
  airtimeOrders     AirtimeOrder[]
  airtimeGiveaways  AirtimeGiveaway[]
}

model Wallet {
  id             String   @id @default(cuid())
  userId         String   @unique

  taskBalance    Decimal  @default(0) @db.Decimal(18, 2)
  referralBalance Decimal @default(0) @db.Decimal(18, 2)
  onehubBalance  Decimal  @default(0) @db.Decimal(18, 2)
  whotBalance    Decimal  @default(0) @db.Decimal(18, 2)
  tappingBalance Decimal  @default(0) @db.Decimal(18, 2)

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  walletType  String
  type        String
  category    String
  description String
  amount      Decimal  @db.Decimal(18, 2)
  status      String   @default("COMPLETED")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([walletType])
  @@index([category])
}

model WhotSettings {
  id             String   @id @default("default")
  isEnabled      Boolean  @default(true)
  dailySpinLimit Int      @default(3)
  prizes         WhotPrize[]
  updatedAt      DateTime @updatedAt
}

model WhotPrize {
  id          String       @id @default(cuid())
  settingsId  String
  label       String
  amount      Decimal      @db.Decimal(18, 2)
  probability Decimal      @db.Decimal(8, 4)
  color       String
  sortOrder   Int          @default(0)
  isActive    Boolean      @default(true)
  settings    WhotSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)
  spins       WhotSpin[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([settingsId, sortOrder])
}

model WhotSpin {
  id          String    @id @default(cuid())
  userId      String
  prizeId     String?
  dayKey      String
  spinNumber  Int
  prizeLabel  String
  reward      Decimal   @db.Decimal(18, 2)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  prize       WhotPrize? @relation(fields: [prizeId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@unique([userId, dayKey, spinNumber])
  @@index([userId, createdAt])
  @@index([dayKey])
}
model Admin {
  id           String   @id @default(cuid())
  fullName     String
  email        String   @unique
  passwordHash String
  role         String   @default("SUPER_ADMIN")
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdTasks MiningTask[]

}
model MiningTask {
  id                String   @id @default(cuid())
  title             String
  description       String   @db.Text
  instructions      String   @db.Text
  taskLink          String?
    sharePlatform String?
  shareMessage  String?  @db.Text
  category          String   @default("REGULAR")
  reward            Decimal  @db.Decimal(18, 2)
  minDurationSeconds Int      @default(30)
  proofType         String   @default("TEXT")
  proofInstructions String?  @db.Text
  status            String   @default("ACTIVE")
  maxCompletions    Int?
  totalCompletions  Int      @default(0)
  startsAt          DateTime?
  endsAt            DateTime?

  createdById       String?
  createdBy         Admin?   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  progress           TaskProgress[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status, category])
  @@index([createdAt])
}

model TaskProgress {
  id         String   @id @default(cuid())
  taskId     String
  userId     String
  startedAt  DateTime @default(now())
  claimedAt  DateTime?
  cycleStart DateTime
  task       MiningTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId, cycleStart])
  @@index([userId, startedAt])
  @@index([userId, cycleStart])
}

model PayoutProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  payoutMethod   String   @default("BANK")
  bankName       String?
  accountName    String?
  accountNumber  String?
  bankCode       String?
  countryCode    String?
  countryName    String?
  payoutCurrency String?
  cryptoNetwork  String?
  walletAddress  String?
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Withdrawal {
  id              String   @id @default(cuid())
  userId          String
  walletType      String
  amount          Decimal  @db.Decimal(18, 2)
  payoutMethod    String
  payoutDetails   Json
  walletBreakdown Json?
  status          String   @default("PENDING")
  adminNote       String?
  processedAt     DateTime?
  processingAt    DateTime?
  approvedAt      DateTime?
  paidAt          DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}
model CouponBatch {
  id                String             @id @default(cuid())
  name              String?
  totalCodes        Int
  createdByAdminId  String?
  expiresAt         DateTime
  coupons           WithdrawalCoupon[]
  createdAt         DateTime           @default(now())

  @@index([createdAt])
  @@index([expiresAt])
}

model WithdrawalCoupon {
  id                    String      @id @default(cuid())
  batchId               String
  codeHash              String      @unique
  encryptedCode         String?
  status                String      @default("ACTIVE")
  expiresAt             DateTime
  redeemedAt            DateTime?
  redeemedByUserId      String?
  redeemedWithdrawalId  String?     @unique
  disabledAt            DateTime?
  batch                 CouponBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  createdAt             DateTime    @default(now())

  @@index([batchId, status])
  @@index([status, expiresAt])
  @@index([redeemedByUserId])
}


model TappingProgress {
  id            String   @id @default(cuid())
  userId        String   @unique
  taps          Int      @default(0)
  lastClaimedAt DateTime?
  lastTapAt     DateTime?
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([lastClaimedAt])
}
model CouponSettings {
  id                       String   @id @default("default")
  customerServiceUrl       String?
  topupWizardTokenEncrypted String?
  updatedAt                DateTime @updatedAt
}
model Announcement {
  id          String   @id @default(cuid())
  title       String   @db.VarChar(160)
  message     String   @db.Text
  status      String   @default("DRAFT")
  publishedAt DateTime?
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([expiresAt])
}

model AirtimeSettings {
  id                    String   @id @default("default")
  airtimeEnabled        Boolean  @default(false)
  dataEnabled           Boolean  @default(false)
  mtnEnabled            Boolean  @default(true)
  airtelEnabled         Boolean  @default(true)
  gloEnabled            Boolean  @default(true)
  nineMobileEnabled     Boolean  @default(true)
  minimumAmountNgn      Decimal  @default(50) @db.Decimal(18, 2)
  maximumAmountNgn      Decimal  @default(50000) @db.Decimal(18, 2)
  markupPercent         Decimal  @default(0) @db.Decimal(8, 4)
  minimumDataAmountNgn  Decimal  @default(50) @db.Decimal(18, 2)
  maximumDataAmountNgn  Decimal  @default(50000) @db.Decimal(18, 2)
  exchangeRateSource    String   @default("EXCHANGE_RATE_API")
  exchangeRateOverride  Decimal? @db.Decimal(18, 6)
  updatedAt             DateTime @updatedAt
}

model AirtimePlan {
  id             String   @id @default(cuid())
  serviceId      String   @unique
  network        String
  type           String
  name           String
  amountNgn      Decimal  @db.Decimal(18, 2)
  validity       String?
  description    String?  @db.Text
  isActive       Boolean  @default(true)
  lastSyncedAt   DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([network, type, isActive])
}

model AirtimeOrder {
  id                    String   @id @default(cuid())
  reference             String   @unique
  providerReference     String?
  userId                String
  network               String
  type                  String
  serviceId             String
  phoneNumber           String
  amountNgn             Decimal  @db.Decimal(18, 2)
  markupNgn             Decimal  @default(0) @db.Decimal(18, 2)
  exchangeRate          Decimal  @db.Decimal(18, 6)
  amountEur             Decimal  @db.Decimal(18, 2)
  status                String   @default("PENDING")
  providerStatus        String?
  providerResponse      Json?
  failureReason         String?  @db.Text
  walletDebitedAt       DateTime?
  refundedAt            DateTime?
  deliveredAt           DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([providerReference])
}

model AirtimeGiveaway {
  id                String   @id @default(cuid())
  reference         String   @unique
  userId            String
  type              String   @default("AIRTIME")
  network           String
  serviceId         String?
  planName          String?
  phoneNumber       String
  amountNgn         Decimal  @db.Decimal(18, 2)
  providerReference String?
  status            String   @default("PENDING")
  providerResponse  Json?
  failureReason     String?  @db.Text
  deliveredAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}